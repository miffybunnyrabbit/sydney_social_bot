# Copy to .env and fill in. main.py loads this via python-dotenv.

# --- Telegram (see README "Telegram setup") ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Anthropic (used to read event flyers: image + caption -> structured fields) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- vibatchium ---
VB_BIN=vb
VB_SESSION=instagram

# --- Behaviour tuning ---
# How many posts back to check per account per run (most accounts post
# less than once a day, but a couple of the big hub accounts post often).
POSTS_PER_ACCOUNT=3
# How many discovery search-queries / hub accounts to burn through per run.
# The full lists in config/discovery.yaml are longer than this on purpose —
# the bot rotates through a slice each day instead of doing all of them at
# once (keeps daily IG traffic from this account low and steady).
DISCOVERY_QUERIES_PER_RUN=8
DISCOVERY_HUBS_PER_RUN=2
# Seconds to sleep between accounts while scanning, to avoid hammering IG.
SCAN_DELAY_SECONDS=2
